 #include <stdio.h>
 int calculate(){
  int num1,num2;
  int op;
  int result;
  printf("Enter 1st number");
  scanf("%d",&num1);

  printf("ENTER OPERATOR ( +,-,*,/):");
  scanf(" %c", &op);
  
   printf("Enter 2nd number");
  scanf("%d",&num2);

  switch (op){
    case '+':
    result = num1 + num2;
    printf("Result: %d + %d = %d\n",num1,num2,result);
    break;
    
     case '-':
    result = num1 - num2;
    printf("Result: %d - %d = %d\n",num1,num2,result);
    break;
    
    case '*':
    result = num1 * num2;
    printf("Result: %d * %d = %d\n",num1,num2,result);
    break;

    case '/':
    if(num2!=0){
          result = num1 / num2;
        printf("Result: %d / %d = %d\n",num1,num2,result);
    }
    else {
         printf("Error division by zero is not allowed.\n");
     }
     break;
     default:
     printf("Eroor: invalid operator entered.\n");
     break;
 
  } 

 }



 int main (){


  calculate();





  return 0;

 }